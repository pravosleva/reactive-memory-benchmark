{
  "name": "reactive-memory-benchmark",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Isolated V8 memory footprint, GC churn, and disposal leak benchmark for 10 reactive engines",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "bench": "bash bench.sh",
    "report": "node generate-svg.mjs && node generate-png.mjs && node update-readme.mjs",
    "upd:readme": "node ~/projects/reactive-memory-benchmark/update-readme.mjs",
    "upd:svg-png": "node generate-svg.mjs && node generate-png.mjs"
  },
  "dependencies": {
    "@angular/core": "^22.3.0",
    "@pravosleva/reactive-engine": "^3.0.4",
    "@preact/signals-core": "^1.14.5",
    "@reatom/core": "^1001.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@solidjs/signals": "^2.0.3",
    "@vue/reactivity": "^3.5.46",
    "alien-signals": "^3.2.1",
    "effector": "^23.4.4",
    "mobx": "^7.1.7",
    "mol_wire_lib": "^1.0.1852"
  }
}